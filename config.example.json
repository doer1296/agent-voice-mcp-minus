{
  "engine": "cloud",
  "cloud": {
    "provider": "volcano",
    "apiKey": "${VOLCANO_API_KEY}",
    "voice": "zh_female_daimengchuanmei_moon_bigtts",
    "resourceId": "seed-tts-1.0",
    "format": "pcm",
    "sampleRate": 24000,
    "silenceDuration": 400,
    "disableMarkdownFilter": true,
    "disableEmojiFilter": true,
    "leadingSilence": 1500,
    "pauseControl": true,
    "pauseSentenceMs": 400,
    "pauseCommaMs": 200,
    "timeout": 30000,
    "mimo": {
      "_comment": "MiMo V2.5 第二引擎（可选）：把 provider 改为 mimo 并填 apiKey 即启用。情绪/语速/音量由自然语言指令表达（客户端量化），无数值级控制。",
      "apiKey": "${MIMO_API_KEY}",
      "voice": "冰糖",
      "model": "mimo-v2.5-tts",
      "emotionPrompts": {
        "happy": "用轻快上扬、充满喜悦的语气朗读，声音明亮有活力"
      },
      "scenePrompts": {
        "task_error": "报告错误时语气严肃但不夸张，语速平稳"
      }
    }
  },
  "startupWelcome": false,
  "webui": {
    "_comment": "可视化控制台（v1.5.0）：服务启动后在浏览器打开 http://127.0.0.1:47614 —— 状态面板 / 试播 / 音色试听 / 配置编辑（Key 脱敏）。仅监听本机回环地址",
    "enabled": true,
    "port": 47614
  },
  "rate": 200,
  "volume": 1.3,
  "notificationSound": "melodious",
  "sceneSounds": {
    "task_start": "beep:single",
    "task_complete": "beep:single",
    "task_error": "beep:single",
    "need_interaction": "beep:single",
    "milestone": "beep:single"
  },
  "textClean": true,
  "maxTextLength": 200,
  "fallbackEngine": "windows-sapi",
  "watcher": {
    "enabled": true
  },
  "scenes": {
    "task_start": {
      "voice": "zh_female_daimengchuanmei_moon_bigtts",
      "rate": 190,
      "volume": 1.3,
      "emotion": "calm"
    },
    "task_complete": {
      "voice": "zh_female_daimengchuanmei_moon_bigtts",
      "rate": 220,
      "volume": 1.3,
      "emotion": "happy"
    },
    "task_error": {
      "voice": "zh_female_daimengchuanmei_moon_bigtts",
      "rate": 210,
      "volume": 1.3,
      "emotion": "angry"
    },
    "need_interaction": {
      "voice": "zh_female_daimengchuanmei_moon_bigtts",
      "rate": 200,
      "volume": 1.3,
      "emotion": "calm"
    },
    "milestone": {
      "voice": "zh_female_daimengchuanmei_moon_bigtts",
      "rate": 210,
      "volume": 1.3,
      "emotion": "happy"
    }
  }
}
